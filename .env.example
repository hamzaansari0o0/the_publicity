# ----------------------------------------------------------------------------
# The Publicity - environment variables
#
# 1. Copy this file to `.env`  (cp .env.example .env)
# 2. Fill in your real values.
#
# `.env` and every `.env.*` file are git-ignored. Only this example file is
# committed, so keep REAL credentials out of it.
# Variables starting with NEXT_PUBLIC_ are visible in the browser - never put
# secrets in them.
# ----------------------------------------------------------------------------

# --- Database (MongoDB Atlas or a local MongoDB) -----------------------------
# Atlas : mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Local : mongodb://127.0.0.1:27017
# Without this the site still works, but the contact form and QR tracking
# will report that the database is not connected.
MONGODB_URI=
MONGODB_DB=the_publicity

# --- Site ---------------------------------------------------------------------
# Public URL of the website, no trailing slash (used for SEO, sitemap, QR demo).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Business contact details shown on the website ----------------------------
# Email and phone default to the agency's real details in src/data/site.ts.
# Uncomment only to override them:
# NEXT_PUBLIC_CONTACT_EMAIL=
# NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_ADDRESS=Lahore, Pakistan
# Optional - leave empty to hide the opening-hours line.
NEXT_PUBLIC_BUSINESS_HOURS=
# WhatsApp number, international format, digits only (e.g. 923001234567).
# When set, the QR demo and WhatsApp buttons open a chat with this number.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Social links (empty = placeholder "#") -----------------------------------
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
